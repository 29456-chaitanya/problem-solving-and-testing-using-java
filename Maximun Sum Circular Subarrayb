class Solution {
    public int maxSubarraySumCircular(int[] nums) {
        int totalSum = 0;
        
        int maxSoFar = nums[0];
        int currentMax = 0;
        
        int minSoFar = nums[0];
        int currentMin = 0;
        
        for (int num : nums) {
            totalSum += num;
            
            // Standard Kadane's for Maximum Subarray
            currentMax = Math.max(num, currentMax + num);
            maxSoFar = Math.max(maxSoFar, currentMax);
            
            // Inverted Kadane's for Minimum Subarray
            currentMin = Math.min(num, currentMin + num);
            minSoFar = Math.min(minSoFar, currentMin);
        }
        
        // Edge case: If all numbers are negative, maxSoFar will be the largest negative number.
        // totalSum - minSoFar would give 0 (empty set), which is invalid since subarray must be non-empty.
        if (maxSoFar < 0) {
            return maxSoFar;
        }
        
        // Return the maximum of non-wrapped and wrapped subarray sum
        return Math.max(maxSoFar, totalSum - minSoFar);
    }
}
