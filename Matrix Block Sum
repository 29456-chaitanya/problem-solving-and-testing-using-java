class Solution {
    public int[][] matrixBlockSum(int[][] mat, int k) {
        int m = mat.length;
        int n = mat[0].length;
        
        // Step 1: Build 1-indexed 2D Prefix Sum array
        int[][] pref = new int[m + 1][n + 1];
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                pref[i + 1][j + 1] = mat[i][j] 
                                  + pref[i][j + 1] 
                                  + pref[i + 1][j] 
                                  - pref[i][j];
            }
        }
        
        int[][] answer = new int[m][n];
        
        // Step 2: Query submatrix sums using prefix array in O(1)
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                // Clamp boundaries to valid matrix dimensions
                int r1 = Math.max(0, i - k);
                int c1 = Math.max(0, j - k);
                int r2 = Math.min(m - 1, i + k);
                int c2 = Math.min(n - 1, j + k);
                
                // Calculate submatrix sum from (r1, c1) to (r2, c2)
                answer[i][j] = pref[r2 + 1][c2 + 1] 
                             - pref[r1][c2 + 1] 
                             - pref[r2 + 1][c1] 
                             + pref[r1][c1];
            }
        }
        
        return answer;
    }
}
